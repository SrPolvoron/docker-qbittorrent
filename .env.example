# Copy to .env; use literal values, without quotes or shell expansion.
PROJECT_NAME=srpolvoron-qbittorrent
PUID=1000
PGID=1000
TZ=Europe/Madrid
# 8081 avoids colliding with an existing Jellyfin stack's qBittorrent on 8080.
WEBUI_PORT=8081
# Internal listening port only; NO host TCP/UDP mappings by default.
TORRENTING_PORT=6882
# App state must NOT be shared with any other running qBittorrent container.
CONFIG_ROOT=/srv/qbittorrent/config
# For optional hardlink-capable Jellyfin integration, use the same HOST root as
# Radarr/Sonarr (often /srv/media) BEFORE the first download. See both READMEs.
DATA_ROOT=/srv/qbittorrent/data
# Only used by ./stack up --media; create using ./stack network-create.
SHARED_NETWORK=media-downloads
# Only used by ./stack up --vpn; use an IP assigned to WG_INTERFACE on this host.
WG_INTERFACE=wg0
WG_BIND_IP=
# Only resolved to a digest by ./stack lock. No automatic rolling updates.
QBITTORRENT_SOURCE_IMAGE=lscr.io/linuxserver/qbittorrent:latest
